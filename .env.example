# Backend
DATABASE_URL=postgresql+psycopg://ledgr:ledgr@localhost:5433/ledgr
ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
SQL_ECHO=false

# Authentication
# People create an organization on the console's "Create account" tab (they become its
# OWNER) and sign in with email + password. Sessions are server-side, revocable, and sent
# as an httpOnly cookie (with a CSRF header on writes). API keys are for integrations only.
# ALLOW_SIGNUP=true
# On any public deployment, require an invite code to create organizations:
# SIGNUP_TOKEN=
# Public deployment over HTTPS: SESSION_COOKIE_SECURE=true (and set CORS_ORIGINS to your web origin)
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_SAMESITE=lax
# SESSION_TTL_MINUTES=480
# SESSION_IDLE_MINUTES=60
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15
# RATE_LIMIT_LOGIN_PER_MINUTE=10
# RATE_LIMIT_REGISTER_PER_HOUR=10
# Local/demo only: the seed script creates the demo organization's owner from these.
# Leave the password unset to get a random one printed once in the migrate logs.
# BOOTSTRAP_ADMIN_EMAIL=owner@demo.ledgr.test
# BOOTSTRAP_ADMIN_PASSWORD=

# Operational alert thresholds (deterministic rules; minor units)
# ALERT_WINDOW_HOURS=24
# ALERT_LARGE_TRANSACTION_MINOR=10000000
# ALERT_REPEAT_THRESHOLD=3
# ALERT_BALANCE_FLOOR_WARNING_MINOR=50000

# LEDGR Intelligence (optional - AI features are unavailable when unset)
# AI_PROVIDER=gemini   # gemini | anthropic | openai
# AI_MODEL=
# AI_API_KEY=
# AI_BASE_URL=
# AI_MAX_TOOL_ITERATIONS=4
# AI_REQUEST_TIMEOUT_SECONDS=30
# AI_RATE_LIMIT_PER_MINUTE=20

# Frontend (frontend/.env)
# VITE_API_BASE_URL=http://localhost:8000/api/v1
